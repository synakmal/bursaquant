# Server-side only. Never put these values in index.html, src/, GitHub Pages, or browser storage.
TWELVE_DATA_API_KEY=
ISAHAM_API_TOKEN=

# Optional exact frontend origin for CORS, e.g. https://YOURNAME.github.io
# If blank, the gateway accepts GitHub Pages, localhost and matching Vercel origins.
BQ_ALLOWED_ORIGIN=

# Optional Yahoo personal trial. No provider API key is used by this adapter.
# Enable only after reviewing Yahoo's permitted access and data-use terms.
BQ_DATA_PROVIDER=yahoo
# Required for a hosted personal Yahoo gateway. Enter the same value in the app's
# Access code field; use a long random value and do not commit it.
BQ_ACCESS_TOKEN=
